{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "watchlist",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": false,
	"kv_namespaces": [
		{
			"binding": "WATCHLIST_KV",
			"id": "1be7f0e039e24a128957a523981f3381"
		}
	],
	// Local dev simulation of Cloudflare Access (`wrangler dev` only). Not a
	// real Access application; production Access must be configured manually
	// in the Cloudflare dashboard against the deployed Worker. "aud" and
	// "identity" are synthetic, non-production placeholder values.
	"access": {
		"dev": {
			"aud": "local-development-audience",
			"identity": {
				"email": "developer@example.test",
				"name": "Local Development User",
				"user_uuid": "local-development-user"
			}
		}
	}
}
