{
    "permissions": {
        "allow": [
            "Bash(npm install)",
            "Bash(npm run *)",
            "Bash(npm test)",
            "Bash(npx *)",
            "Bash(git status)",
            "Bash(git status *)",
            "Bash(git diff)",
            "Bash(git diff *)",
            "Bash(git log)",
            "Bash(git log *)"
        ],
        "ask": [
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push *)",
            "Bash(git reset *)",
            "Bash(git clean *)",
            "Bash(git checkout *)",
            "Bash(git restore *)",
            "Bash(rm *)",
            "Bash(wrangler deploy *)",
            "Bash(npx wrangler deploy *)",
            "Bash(wrangler kv *)",
            "Bash(npx wrangler kv *)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)"
        ]
    }
}